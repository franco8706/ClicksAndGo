# =====================================================================
# CLICKS & GO — Plantilla ÚNICA de variables de entorno
# ---------------------------------------------------------------------
# • Local (docker-compose.local.yml): copiá este archivo a `.env` y completá.
# • Producción (Cloud Run): los SECRETOS viven en Google Secret Manager
#   (DATABASE_URL, SECRET_KEY_BASE, MONGODB_URI, AUTH_SECRET). El resto se
#   define como env plano en los manifests Infra/cloud/cloudrun-*.yaml.
# • NUNCA commitees el `.env` real (está en .gitignore).
# =====================================================================

# ── 1. Núcleo / runtime ───────────────────────────────────────────────
NODE_ENV=development            # development | production
PORT=3000
RUST_LOG=info

# ── 2. PostgreSQL — Cloud SQL (Rails API + Web/NextAuth) ───────────────
# Local:  postgres://usuario:password@postgres-db:5432/clicksandgo
# Cloud Run (socket): postgres://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
#   → en prod se inyecta desde Secret Manager (secreto DATABASE_URL).
DATABASE_URL=postgres://usuario:password@postgres-db:5432/clicksandgo
# CA de Cloud SQL para verificar TLS al conectar por IP pública (no hace
# falta con el socket unix de Cloud Run). Ruta al server-ca.pem o PEM inline.
PG_SSL_CA=
PG_SSL_CA_CONTENT=

# ── 3. Rails ──────────────────────────────────────────────────────────
SECRET_KEY_BASE=generar_llave_larga_aleatoria   # rails secret / openssl rand -hex 64
# REDIS_URL: OPCIONAL. Si se define, Rails cachea en Redis; si se omite,
# usa memory_store automáticamente (así corre en Cloud Run sin Memorystore).
REDIS_URL=

# ── 4. MongoDB Atlas — data lake / telemetría de agentes ──────────────
# Local:  mongodb://mongodb_lake:27017
# Prod:   mongodb+srv://USER:PASS@cluster.mongodb.net/clicksandgo  (Secret Manager)
MONGODB_URI=mongodb://mongodb_lake:27017

# ── 5. Interconexión de microservicios ────────────────────────────────
# En Cloud Run se apunta a las URLs internas (ver cloudrun-*.yaml).
RAILS_API_URL=http://rails_backend:3000
RUST_API_URL=http://rust_engine:8080/api/v1/score/batch
RUST_BENCHMARK_URL=http://rust_engine:8080/api/v1/benchmarks/run
NEXT_PUBLIC_API_URL=http://localhost:8080
# 🛡️ Clave compartida Web <-> Rails para /api/v1/users/** (perfil, favoritos,
# alertas). Sin ella, Rails devuelve 401 — cierra el hueco de que Rails
# tiene `ingress: all` en Cloud Run. Generar con: openssl rand -hex 32
INTERNAL_API_KEY=

# ── 6. Inteligencia (cascada de proveedores) ──────────────────────────
# Vertex AI (primario, requiere billing GCP). En Cloud Run la service
# account autentica sola; en local se monta gcp-vertex.json.
GCP_PROJECT_ID=clicks-and-go
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vertex.json
# Gemini API (fallback sin billing — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 💰 Tope diario de llamadas a IA de pago; al superarlo cae a Antigravity (costo 0)
AI_DAILY_LIMIT=500
# Apaga el loop interno de NewsRadar (en Cloud Run lo dispara Cloud Scheduler)
NEWS_LOOP_ENABLED=true

# ── 6b. Tipo de cambio FX (ingesta — data_normalizer) ─────────────────
# Tasas en vivo con caché TTL y fallback determinista (nunca rompe la ingesta).
FX_LIVE_ENABLED=true            # false → usa solo la matriz de respaldo hardcodeada
FX_API_URL=https://open.er-api.com/v6/latest/USD   # sin API key
FX_CACHE_TTL_SECONDS=21600      # 6 h de caché en memoria
FX_RETRY_SECONDS=300            # backoff tras un fallo de red
FX_TIMEOUT_SECONDS=8            # timeout de la llamada HTTP

# ── 7. Benchmarks públicos (PassMark — consumidos por Rust) ────────────
BENCHMARK_CPU_URL=https://www.cpubenchmark.net/laptop.html
BENCHMARK_GPU_URL=https://www.videocardbenchmark.net/laptop_video_card_list.html

# ── 8. Autenticación (NextAuth v5) ────────────────────────────────────
AUTH_SECRET=                    # openssl rand -base64 33  (prod → Secret Manager)
AUTH_URL=https://tu-dominio.com # URL canónica (protege host-header injection)
AUTH_TRUST_HOST=true
# OAuth — cada proveedor se activa solo si SUS DOS claves están presentes
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Magic links por email (Resend). También los usa el PriceAlertAgent (Python)
# para enviar los avisos de "bajó de precio". Sin AUTH_RESEND_KEY, el agente
# detecta las alertas alcanzadas pero no envía (las deja pendientes).
AUTH_RESEND_KEY=
AUTH_FROM_EMAIL=noreply@clicksandgo.com
# Base pública del sitio para el link al producto dentro del email de alerta.
PUBLIC_WEB_URL=https://clicksandgo.com

# ── 9. Redes de afiliados (completar al obtener aprobación) ────────────
# AWIN (HP/Lenovo/Dell/Asus EU-UK) · CJ (Best Buy/Newegg US-CA) · Amazon PAAPI (US)
AWIN_API_KEY=
AWIN_PUBLISHER_ID=
AWIN_FEED_ID=
CJ_API_KEY=
CJ_WEBSITE_ID=
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=
AMAZON_PARTNER_TAG=
