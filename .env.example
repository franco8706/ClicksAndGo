# =====================================================================
# CLICKS & GO — Plantilla de variables de entorno
# Copiar a `.env` y completar. NUNCA commitear el `.env` real.
# =====================================================================

# ── Base de datos (Rails + Web/auth) ──────────────────────────────────
DATABASE_URL=postgres://usuario:password@host:5432/clicksandgo
# CA de Cloud SQL para verificar TLS en producción (recomendado).
# Poné la ruta al server-ca.pem, o pegá el PEM completo en PG_SSL_CA_CONTENT.
PG_SSL_CA=
PG_SSL_CA_CONTENT=

# ── Rails ─────────────────────────────────────────────────────────────
SECRET_KEY_BASE=generar_una_llave_larga_aleatoria
REDIS_URL=

# ── MongoDB (telemetría / data lake) ──────────────────────────────────
MONGODB_URI=mongodb://usuario:password@host:27017

# ── Inteligencia (Vertex AI — requiere billing GCP) ───────────────────
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# El JSON del service account se monta en el contenedor (gcp-vertex.json)

# ── Autenticación (NextAuth v5) ───────────────────────────────────────
# Secreto de firma de sesiones/tokens — generar con: openssl rand -base64 33
AUTH_SECRET=
# URL canónica del sitio (protege contra host-header injection en callbacks)
AUTH_URL=https://tu-dominio.com
# OAuth (opcional — cada proveedor se activa solo si sus dos claves están)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
# Magic links por email (Resend)
AUTH_RESEND_KEY=
AUTH_FROM_EMAIL=noreply@clicksandgo.com
